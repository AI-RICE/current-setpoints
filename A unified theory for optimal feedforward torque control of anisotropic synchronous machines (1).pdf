         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A unified theory for optimal feedforward torque control of anisotropic synchronous machines</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Hisham Eldeeb</rdf:li>
               <rdf:li>Christoph M. Hackl</rdf:li>
               <rdf:li>Lorenz Horlbeck</rdf:li>
               <rdf:li>Julian Kullick</rdf:li>
            </rdf:Seq>
